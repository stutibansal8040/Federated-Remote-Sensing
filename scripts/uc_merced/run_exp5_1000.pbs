#!/bin/bash
#PBS -N exp5_hybrid_1000
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=12:00:00

cd "$PBS_O_WORKDIR"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate rsccl

# Restrict this job to one GPU explicitly
export CUDA_VISIBLE_DEVICES=0

echo "======================================"
echo "EXPERIMENT 5: FedNova Hybrid"
echo "======================================"
echo "Host: $(hostname)"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo "Start: $(date)"

python - <<'PYTHON'
import os
import torch

print("CUDA_VISIBLE_DEVICES:", os.environ.get("CUDA_VISIBLE_DEVICES"))
print("CUDA available:", torch.cuda.is_available())
print("GPU count visible to PyTorch:", torch.cuda.device_count())

if torch.cuda.is_available():
    print("Visible GPU 0:", torch.cuda.get_device_name(0))
PYTHON

python main_experiment.py \
    configs_1000_rounds/exp5_fednova_hybrid_1000.yaml

echo "FINISHED: $(date)"
