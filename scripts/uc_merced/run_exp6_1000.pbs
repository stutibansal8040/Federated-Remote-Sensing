#!/bin/bash
#PBS -N exp6_hybrid_logit_1000
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=12:00:00

cd "$PBS_O_WORKDIR"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate rsccl

# Restrict this job to one GPU explicitly
export CUDA_VISIBLE_DEVICES=0

echo "======================================"
echo "EXPERIMENT 6: FedNova Hybrid + Logit"
echo "Adaptive Gamma: ON"
echo "Temperature Queue: ON"
echo "Logit Adjustment: ON"
echo "Rounds: 1000"
echo "Host: $(hostname)"
echo "Start: $(date)"
echo "======================================"

python - <<'PYTHON'
import torch
print("PyTorch:", torch.__version__)
print("CUDA available:", torch.cuda.is_available())

if torch.cuda.is_available():
    print("GPU:", torch.cuda.get_device_name(0))
    print("GPU count:", torch.cuda.device_count())
PYTHON

python main_experiment.py \
    configs_1000_rounds/exp6_fednova_hybrid_logit_1000.yaml

echo "======================================"
echo "EXPERIMENT 6 FINISHED: $(date)"
echo "======================================"
